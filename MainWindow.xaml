<Window x:Class="NineRouterBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="9Router" Width="1200" Height="800">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button x:Name="RefreshButton" Content="⟳ Refresh (F5)" Click="RefreshButton_Click" Margin="4,0"/>
            <Separator/>
            <TextBlock Text="http://localhost:20128" VerticalAlignment="Center" Opacity="0.6" Margin="4,0"/>
        </ToolBar>
        <Grid>
            <wv2:WebView2 x:Name="Browser"/>

            <!-- Loading: shown while 9router is starting -->
            <Border x:Name="LoadingOverlay" Background="#F5F5F5">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                    <TextBlock Text="🚀 Starting 9router…" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingStatus" Text="Launching process…" Margin="0,8,0,16"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="8" Margin="0,0,0,12"/>
                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LoadingLog" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap" Opacity="0.8"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Offline: shown when 9router is not running and could not be started -->
            <Border x:Name="OfflineOverlay" Visibility="Collapsed" Background="#F5F5F5">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="9router is not running" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OfflineDetail" Text="Could not start 9router automatically."
                               Margin="0,8,0,16" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button x:Name="RetryButton" Content="Start 9router again" Width="180" Height="32"
                            HorizontalAlignment="Center" Click="RetryButton_Click"/>
                    <Button x:Name="CopyErrorLog" Content="Copy Error Log" Width="180" Height="32" Click="CopyErrorLogClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
